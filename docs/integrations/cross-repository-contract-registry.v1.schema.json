{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mochirii:cross-repository-contract-registry:v1",
  "title": "Mochirii cross-repository contract registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "updatedDate",
    "registryStatus",
    "repositories",
    "contracts"
  ],
  "properties": {
    "$schema": {
      "const": "./cross-repository-contract-registry.v1.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "updatedDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "registryStatus": {
      "const": "target_only_unversioned"
    },
    "repositories": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/contract"
      }
    }
  },
  "$defs": {
    "repository": {
      "type": "string",
      "enum": [
        "Mochirii-Wushu/Mochirii-Website",
        "Mochirii-Wushu/Mochirii-Social",
        "Mochirii-Wushu/Mochirii-Social-Mobile",
        "Mochirii-Wushu/Mochirii-Forums",
        "Mochirii-Wushu/Reaper-Discord-Bot",
        "Mochirii-Wushu/Mochirii-Pets"
      ]
    },
    "contractId": {
      "type": "string",
      "enum": [
        "website-session-guild-entitlement",
        "social-oauth-handoff-account-mapping",
        "social-api-media-behavior",
        "gallery-ingest-moderation",
        "discord-command-manifest",
        "member-synchronization",
        "guild-event-schedule",
        "spinner-draw-publication",
        "spotlight-vote-workflows",
        "mochi-pets-launch-ticket",
        "unity-artifact-manifest",
        "forum-central-identity"
      ]
    },
    "gap": {
      "type": "string",
      "enum": [
        "contract_version",
        "versioned_artifact",
        "concrete_artifact",
        "producer_compatibility_test",
        "consumer_compatibility_test",
        "cross_repository_fixture",
        "rollback_window"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "kind"],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "kind": {
          "type": "string",
          "enum": ["documentation", "schema", "interface", "manifest", "fixture"]
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "coverage"],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "coverage": {
          "type": "string",
          "enum": ["producer", "consumer", "cross_repository"]
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "version",
        "producerRepositories",
        "consumerRepositories",
        "compatibilityRequirements",
        "artifacts",
        "tests",
        "rollbackWindowDays",
        "gaps"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/contractId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["unversioned", "incomplete", "versioned"]
        },
        "version": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^v[1-9]\\d*$" }
          ]
        },
        "producerRepositories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repository"
          }
        },
        "consumerRepositories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repository"
          }
        },
        "compatibilityRequirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/test"
          }
        },
        "rollbackWindowDays": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 }
          ]
        },
        "gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/gap"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "const": "unversioned" }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "version": { "type": "null" },
              "gaps": {
                "minItems": 1,
                "contains": { "const": "contract_version" }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "const": "incomplete" }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "gaps": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "const": "versioned" }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "version": { "type": "string" },
              "gaps": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "rollbackWindowDays": { "type": "null" }
            },
            "required": ["rollbackWindowDays"]
          },
          "then": {
            "properties": {
              "gaps": {
                "contains": { "const": "rollback_window" }
              }
            }
          }
        }
      ]
    }
  }
}
