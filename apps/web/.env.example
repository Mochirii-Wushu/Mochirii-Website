NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Server-only allowlist binding for the pre-registered Social OAuth client.
MOCHIRII_SOCIAL_OAUTH_CLIENT_ID=

# Server-only Mōchirīī Forums account handoff. Keep disabled until the Forums
# consumer is ready with the same 32-byte lowercase-hex secret.
MOCHIRII_FORUMS_DISCOURSE_CONNECT_ENABLED=false
MOCHIRII_FORUMS_DISCOURSE_CONNECT_SECRET=

# Server-only Mochi Pets Website tester doorway. Never prefix these with NEXT_PUBLIC_.
MOCHI_PETS_TESTER_PASSWORD=
MOCHI_PETS_TESTER_SESSION_SECRET=
