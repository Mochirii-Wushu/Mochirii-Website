{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "next dev",
    "clean": "node scripts/clean.mjs",
    "build:clean": "npm run clean && next build",
    "build": "next build",
    "check:client-bundle": "node scripts/check-client-bundle.mjs",
    "check:font-bundle": "node scripts/check-font-bundle.mjs",
    "check:route-css-bundle": "node scripts/check-route-css-bundle.mjs",
    "test:web-runtime-performance": "node --experimental-default-type=module --experimental-strip-types --test config/event-cover-image-patterns_test.ts lib/auth-load-generation_test.ts lib/guild-schedule_test.ts lib/events/reference-time_test.ts lib/events/schedule-refresh_test.ts lib/events/public-schedule_test.ts lib/events/participation-render_test.ts lib/observability/authenticated-route-timing_test.ts",
    "vercel:build:local": "npm run clean && cd ../.. && vercel build --prod --cwd apps/web",
    "vercel:version": "vercel --version",
    "start": "next start",
    "lint": "eslint",
    "test:spinner-private": "node --experimental-default-type=module --experimental-strip-types --test ../../tests/spinner-media-renderer.test.ts ../../tests/spinner-proxy.test.ts",
    "toolchain:check": "node scripts/check-local-toolchain.mjs",
    "verify:local": "npm run toolchain:check && npm run test:web-runtime-performance && npm run lint && npm run build && npm run check:client-bundle && npm run check:font-bundle && npm run check:route-css-bundle"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.7",
    "@napi-rs/webcodecs": "1.4.0",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@tootallnate/once": "2.0.1",
    "baseline-browser-mapping": "2.11.0",
    "brace-expansion": "5.0.12",
    "browserslist": "4.28.7",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "minimatch": "10.2.6",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.5",
    "smol-toml": "1.9.0",
    "source-map-js": "1.2.2",
    "tar": "7.5.22",
    "@vercel/backends": {
      "path-to-regexp": "8.4.2"
    },
    "@vercel/blob": {
      "undici": "6.28.1"
    },
    "@vercel/express": {
      "path-to-regexp": "8.4.2"
    },
    "@vercel/fun": {
      "path-to-regexp": "8.4.2"
    },
    "@vercel/hono": {
      "path-to-regexp": "8.4.2"
    },
    "@vercel/node": {
      "path-to-regexp": "6.3.0",
      "undici": "6.28.1"
    },
    "@vercel/remix-builder": {
      "path-to-regexp": "6.3.0"
    },
    "@vercel/sandbox": {
      "undici": "7.29.1"
    },
    "@vercel/static-config": {
      "ajv": "8.20.0"
    },
    "vercel": {
      "undici": "6.28.1"
    }
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "typescript": "^5",
    "vercel": "57.0.0"
  }
}
