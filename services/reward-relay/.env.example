# Safe checked-in posture. A disabled relay makes no provider requests.
TREMENDOUS_MODE=disabled
TREMENDOUS_ORDERS_ENABLED=false

# Populate only in an approved private environment file after account reconciliation.
TREMENDOUS_API_KEY=
TREMENDOUS_EXPECTED_ORG_ID=
TREMENDOUS_CAMPAIGN_ID=
TREMENDOUS_APPROVED_COUNTRIES=
TREMENDOUS_REVIEWED_PRODUCT_IDS=
TREMENDOUS_FEE_FREE_PRODUCT_IDS=
TREMENDOUS_CONFIGURATION_HASH=

# Generate independently; never commit the real value.
REWARD_RELAY_HMAC_SECRET=

# The Node process must remain loopback-only behind the approved TLS reverse proxy.
REWARD_RELAY_HOST=127.0.0.1
REWARD_RELAY_PORT=8787
REWARD_RELAY_DATABASE_PATH=./data/reward-relay.sqlite3
REWARD_RELAY_REQUEST_TIMEOUT_MS=10000
REWARD_RELAY_MAX_REQUEST_BYTES=16384
REWARD_RELAY_MAX_RESPONSE_BYTES=524288
REWARD_RELAY_MAX_CLOCK_SKEW_SECONDS=60
REWARD_RELAY_RATE_LIMIT_PER_MINUTE=60

# Locked v1 cost controls.
REWARD_MINIMUM_PRIZE_CENTS=1000
REWARD_MAXIMUM_PRIZE_CENTS=5000
REWARD_MAXIMUM_CYCLE_COST_CENTS=5000
REWARD_MAXIMUM_BALANCE_CENTS=10000
REWARD_MINIMUM_AVAILABLE_BALANCE_CENTS=5000
