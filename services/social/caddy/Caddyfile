social.mochirii.com {
	encode zstd gzip
	request_body {
		max_size 100MB
	}
	@retiredCreationAndTokenManagement path /installer /installer/* /register* /auth/sign_up* /auth/invite* /auth/pci* /auth/raw/mastodon* /auth/mastodon* /i/app-email-verify* /i/app-email-resend* /api/auth/app-code-verify /api/auth/onboarding /api/v1.1/auth* /oauth/clients* /oauth/personal-access-tokens* /oauth/scopes /oauth/token/refresh* /oauth/tokens* /settings/developers* /settings/applications* /settings/invites*
	header @retiredCreationAndTokenManagement Cache-Control "private, no-store"
	respond @retiredCreationAndTokenManagement 404
	@dependencyReadiness path /api/service/readiness-check
	header @dependencyReadiness Cache-Control "private, no-store"
	respond @dependencyReadiness 404
	@privateMemberStorage {
		path /storage/m /storage/m/* /storage/_esm.t3 /storage/_esm.t3/* /storage/g /storage/g/* /storage/g1 /storage/g1/* /storage/avatars /storage/avatars/* /storage/cache/avatars /storage/cache/avatars/*
		not path /storage/avatars/default.jpg /storage/avatars/default.png
	}
	header @privateMemberStorage {
		Cache-Control "private, no-store"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	respond @privateMemberStorage "" 404
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Request-ID {http.request.uuid}
		header_down X-Request-ID {http.request.uuid}
	}
}
