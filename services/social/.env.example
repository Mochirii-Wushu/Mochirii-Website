APP_NAME="Mochirii"
APP_ENV="production"
APP_KEY=
APP_DEBUG="false"

# Instance Configuration
OPEN_REGISTRATION="false"
APP_REGISTER="false"
PF_ALLOW_APP_REGISTRATION="false"
ENFORCE_EMAIL_VERIFICATION="false"
PF_MAX_USERS="1000"
OAUTH_ENABLED="true"
ENABLE_CONFIG_CACHE="true"
INSTANCE_DISCOVER_PUBLIC="false"
PF_INSTANCE_USE_BEAGLE_API="false"
INSTANCE_NOTIFY_APP_GATEWAY="false"

# Media Configuration
PF_OPTIMIZE_IMAGES="true"
IMAGE_QUALITY="80"
MAX_PHOTO_SIZE="15000"
MAX_CAPTION_LENGTH="500"
MAX_ALBUM_LENGTH="4"

# Instance URL Configuration
APP_URL="http://localhost"
APP_DOMAIN="localhost"
ADMIN_DOMAIN="localhost"
SESSION_DOMAIN="localhost"
TRUST_PROXIES="*"

# Database Configuration
DB_CONNECTION="mysql"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="pixelfed"
DB_USERNAME="pixelfed"
DB_PASSWORD="pixelfed"
MOCHIRII_READINESS_DEPENDENCY_TIMEOUT_SECONDS="2"

# Redis Configuration
REDIS_CLIENT="predis"
REDIS_SCHEME="tcp"
REDIS_HOST="127.0.0.1"
REDIS_PASSWORD="null"
REDIS_PORT="6379"

# Laravel Configuration
SESSION_DRIVER="database"
CACHE_DRIVER="redis"
QUEUE_DRIVER="redis"
BROADCAST_DRIVER="log"
LOG_CHANNEL="stack"
HORIZON_PREFIX="horizon-"

# ActivityPub Configuration
ACTIVITY_PUB="false"
AP_REMOTE_FOLLOW="false"
AP_INBOX="false"
AP_OUTBOX="false"
AP_SHAREDINBOX="false"
ATOM_FEEDS="false"
NODEINFO="false"
WEBFINGER="false"
PF_NETWORK_TIMELINE="false"
PF_ACCT_MIGRATION_ENABLED="false"
GROUPS_ENABLED="false"
GROUPS_FEDERATION="false"

# Experimental Configuration
EXP_EMC="true"

## Mail Configuration (Post-Installer)
MAIL_DRIVER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="social@mochirii.com"
MAIL_FROM_NAME="Mōchirīī Social"
MAIL_AUTO_TLS=true  # STARTTLS (false to bypass)

## S3 Configuration (Post-Installer)
PF_ENABLE_CLOUD=false
FILESYSTEM_CLOUD=s3
MOCHIRII_PRIVATE_MEDIA_ENABLED=true
MOCHIRII_PRIVATE_MEDIA_URL_TTL_SECONDS=20
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=
#AWS_BUCKET=<BucketName>
#AWS_URL=
#AWS_ENDPOINT=
#AWS_VISIBILITY=private
#AWS_USE_PATH_STYLE_ENDPOINT=false
## Optional (WHEN_SUPPORTED (default) / WHEN_REQUIRED) https://docs.aws.amazon.com/sdkref/latest/guide/feature-dataintegrity.html
# AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_SUPPORTED
# AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_SUPPORTED

## Mochirii Social Sync Configuration (Post-Installer)
## Set on the staging host only. Do not commit real values.
MOCHIRII_SOCIAL_SYNC_URL=
MOCHIRII_SOCIAL_SYNC_SECRET=
MOCHIRII_SOCIAL_SYNC_TIMEOUT=5
MOCHIRII_RAFFLE_LEADERBOARD_URL=
MOCHIRII_RAFFLE_LEADERBOARD_SECRET=
MOCHIRII_RAFFLE_LEADERBOARD_TIMEOUT=5
PF_OIDC_REQUEST_TIMEOUT=10
